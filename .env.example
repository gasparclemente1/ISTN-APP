# Copy to .env for local development (the file is ignored by git), or set these
# in the Render dashboard. None is required to start the server: without them
# the directory is read from data/ and meetings and accounts are unavailable.

# The project's URL, or just its id (abcdefghijkl becomes https://abcdefghijkl.supabase.co).
SUPABASE_URL=
# The publishable ("anon") key. It reaches every browser by design; row level
# security is what protects the data. Never put the service_role key here.
SUPABASE_PUBLISHABLE_KEY=
# Set to google to offer "Continuar com Google" (enable Google in Supabase Auth
# first). Email and password always work; no other provider is offered.
SUPABASE_OAUTH_PROVIDERS=
# Port for local development.
PORT=4173
